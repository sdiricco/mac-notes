{
  "name": "mac-notes",
  "version": "1.1.0",
  "description": "A Mac Notes-like Electron app with Markdown import/export",
  "main": "./out/main/index.js",
  "author": "Simone Di Ricco",
  "private": true,
  "build": {
    "appId": "com.movesolutions.macnotes",
    "productName": "Mac Notes",
    "publish": {
      "provider": "github",
      "owner": "sdiricco",
      "repo": "mac-notes"
    },
    "directories": {
      "output": "release",
      "buildResources": "build"
    },
    "files": [
      "out/**/*",
      "package.json"
    ],
    "asar": true,
    "mac": {
      "target": [
        { "target": "dmg", "arch": ["arm64", "x64"] },
        { "target": "zip", "arch": ["arm64", "x64"] }
      ],
      "category": "public.app-category.productivity",
      "icon": "build/icon.png",
      "darkModeSupport": true,
      "identity": null
    },
    "dmg": {
      "title": "${productName}"
    },
    "win": {
      "target": [{ "target": "nsis", "arch": ["x64"] }],
      "icon": "build/icon.png"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true
    },
    "linux": {
      "target": ["AppImage", "deb"],
      "category": "Utility",
      "icon": "build/icon.png",
      "maintainer": "Simone Di Ricco <simone.diricco@movesolutions.it>"
    }
  },
  "scripts": {
    "dev": "electron-vite dev --watch",
    "build": "electron-vite build",
    "postinstall": "electron-builder install-app-deps",
    "start": "electron-vite preview",
    "icon": "node scripts/make-icon.mjs",
    "pack": "electron-vite build && electron-builder --dir",
    "build:mac": "electron-vite build && electron-builder --mac",
    "build:win": "electron-vite build && electron-builder --win",
    "build:linux": "electron-vite build && electron-builder --linux",
    "release": "electron-vite build && electron-builder --publish always"
  },
  "dependencies": {
    "@codemirror/commands": "^6.10.4",
    "@codemirror/lang-markdown": "^6.5.0",
    "@codemirror/language": "^6.12.4",
    "@codemirror/language-data": "^6.5.2",
    "@codemirror/state": "^6.7.1",
    "@codemirror/theme-one-dark": "^6.1.3",
    "@codemirror/view": "^6.43.6",
    "@electron-toolkit/preload": "^3.0.1",
    "@electron-toolkit/utils": "^3.0.0",
    "@iconify-json/lucide": "^1.2.116",
    "@iconify/vue": "^5.0.1",
    "@primevue/themes": "^4.2.5",
    "@vueuse/core": "^11.3.0",
    "codemirror": "^6.0.2",
    "electron-updater": "^6.3.9",
    "highlight.js": "^11.11.1",
    "marked": "^15.0.4",
    "pinia": "^2.3.0",
    "primeicons": "^7.0.0",
    "primevue": "^4.2.5",
    "quill": "^2.0.3",
    "turndown": "^7.2.0",
    "turndown-plugin-gfm": "^1.0.2",
    "uuid": "^11.0.3"
  },
  "devDependencies": {
    "@vitejs/plugin-vue": "^5.2.1",
    "electron": "^33.2.1",
    "electron-builder": "^25.1.8",
    "electron-vite": "^2.3.0",
    "sharp": "^0.35.3",
    "vite": "^5.4.11"
  }
}
